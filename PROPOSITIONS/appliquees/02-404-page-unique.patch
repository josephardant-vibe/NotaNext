+<!doctype html>
+<html lang="fr">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>NotaNext — page introuvable</title>
+  <link rel="stylesheet" href="/design-system/tokens.css">
+  <style>body { background: var(--color-sys-bg-page); color: var(--color-sys-text-primary); padding: var(--space-6); }</style>
+  <script>
+    // Adresse directe (/s-exercer/, /reglages…) : on renvoie vers la route de l'application (#/…).
+    (function () {
+      var routes = { 's-exercer': 'exercer', 'exercer': 'exercer', 'apprendre': 'apprendre', 'reglages': 'reglages',
+        'mentions-legales': 'mentions-legales', 'confidentialite': 'confidentialite', 'credits': 'credits', 'accueil': 'accueil' };
